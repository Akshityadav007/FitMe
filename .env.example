# Backend
FITME_APP_NAME=FitMe
FITME_ENVIRONMENT=local
FITME_API_V1_PREFIX=/api/v1
FITME_BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
FITME_DATABASE_URL=postgresql+asyncpg://fitme:fitme_password@localhost:5432/fitme

# Docker Compose services
POSTGRES_DB=fitme
POSTGRES_USER=fitme
POSTGRES_PASSWORD=fitme_password
POSTGRES_PORT=5432

# AI providers (at least one is needed for live coaching/vision)
# OpenAI
FITME_OPENAI_API_KEY=
FITME_OPENAI_MODEL=gpt-4o-mini
FITME_OPENAI_VISION_MODEL=gpt-4o-mini
# OpenRouter free tier (OpenAI-compatible)
FITME_OPENROUTER_API_KEY=
FITME_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FITME_OPENROUTER_COACH_MODEL=openrouter/free
FITME_OPENROUTER_VISION_MODEL=
# Per-capability provider selection: "auto" or a provider name
FITME_AI_COACH_PROVIDER=auto
FITME_AI_VISION_PROVIDER=auto

# Flutter
FITME_API_BASE_URL=http://localhost:8000/api/v1
